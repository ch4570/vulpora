# --- nl-sql MCP : 환경 변수 (JSON 설정 nl-sql.config.json 대신/보완) ---
# 우선순위: 환경변수 > nl-sql.config.json > 기본값. 반드시 "읽기 전용 역할"로 접속.

# 대상 DB 종류: postgres | mysql | mssql
NLSQL_DIALECT=postgres

# 연결: 문자열 하나(pg/mysql) 또는 개별 변수(mssql 권장)
PG_CONNECTION_STRING=postgresql://readonly_user:CHANGE_ME@localhost:5432/app
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=app
# PGUSER=readonly_user
# PGPASSWORD=CHANGE_ME

PGSSLMODE=prefer

# 다른 위치의 JSON 설정을 쓰려면:
# NLSQL_CONFIG=/abs/path/nl-sql.config.json

# 안전 가드(선택)
NLSQL_MAX_ROWS=100
NLSQL_MAX_RESULT_BYTES=1048576
NLSQL_MAX_INBOUND_BYTES=4194304
NLSQL_STATEMENT_TIMEOUT_MS=5000
NLSQL_ALLOWED_SCHEMAS=public
NLSQL_MAX_CELL_CHARS=2000
