{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vulpora.local/schemas/session-edit-proposal-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "task_id", "summary", "edits"],
  "properties": {
    "schema": {"type": "string", "const": "vulpora.session-edit-proposal/v1"},
    "task_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "summary": {"type": "string", "minLength": 1, "maxLength": 1024},
    "edits": {"type": "array", "minItems": 1, "maxItems": 4, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "before_sha256", "content"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 2048},
        "before_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "content": {"type": "string"}
      }
    }}
  }
}
