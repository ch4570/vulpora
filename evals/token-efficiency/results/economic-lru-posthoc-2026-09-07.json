  "method": "Restore original source for each mutation, apply exactly one regex substitution, run node --test in an isolated source/test copy. Original tests must pass; detected requires an assertion failure.",
  "mutations": [
    {
      "id": "set-does-not-refresh",
      "pattern": "if\\s*\\(this\\.items\\.has\\(key\\)\\)\\s*this\\.items\\.delete\\(key\\);",
      "replacement": "",
      "count": 1
    },
    {
      "id": "miss-inserts-undefined",
      "pattern": "get\\(key\\)\\s*\\{",
      "replacement": "get(key){if(!this.items.has(key))this.items.set(key,undefined);",
      "count": 1
    },
    {
      "id": "undefined-membership-lost",
      "pattern": "has\\(key\\)\\s*\\{\\s*return this\\.items\\.has\\(key\\);\\s*\\}",
      "replacement": "has(key){return this.items.has(key)&&this.items.get(key)!==undefined;}",
      "count": 1
    }
  ],
