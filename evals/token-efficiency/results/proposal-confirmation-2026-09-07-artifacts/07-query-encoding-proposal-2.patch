 'use strict';
 const test=require('node:test'),assert=require('node:assert/strict');
+const {queryPairs}=require('../src/query.js');
 const {buildSearch}=require('../src/search.js');
+
 test('basic',()=>assert.equal(buildSearch({q:'term'}),'?q=term'));
+test('queryPairs preserves scalar values and entry order',()=>assert.deepEqual(queryPairs({zero:0,flag:false,empty:'',text:'term'}),[['zero','0'],['flag','false'],['empty',''],['text','term']]));
+test('queryPairs expands arrays and omits nullish values',()=>assert.deepEqual(queryPairs({tag:['a',null,'b',undefined,false,0],skip:null,alsoSkip:undefined}),[['tag','a'],['tag','b'],['tag','false'],['tag','0']]));
+test('queryPairs ignores unsupported and nested values without mutation',()=>{
+  const tags=['a',['nested'],'b'];
+  const filters={tags,object:{x:1},fn:()=>{},symbol:Symbol('x'),bigint:1n};
+  assert.deepEqual(queryPairs(filters),[['tags','a'],['tags','b']]);
+  assert.deepEqual(tags,['a',['nested'],'b']);
+  assert.deepEqual(filters,{tags,object:{x:1},fn:filters.fn,symbol:filters.symbol,bigint:1n});
+});
+test('buildSearch URL-encodes repeated query pairs',()=>assert.equal(buildSearch({q:'a b&c',tag:['x','y']}),'?q=a+b%26c&tag=x&tag=y'));
+test('buildSearch returns empty string when no pairs remain',()=>assert.equal(buildSearch({a:null,b:undefined,c:{},d:[],e:1n}),''));
