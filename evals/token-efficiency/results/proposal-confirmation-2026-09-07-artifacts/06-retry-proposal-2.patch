+const test = require('node:test');
+const assert = require('node:assert/strict');
+const {retry} = require('../src/retry.js');
+const {fetchOnce, fetchWithRetry} = require('../src/client.js');
+
+test('immediate success', async () => {
+  assert.equal(await retry(() => 7), 7);
+});
+
+test('retries failures with one-based attempts and waits between calls', async () => {
+  const attempts = [];
+  const waits = [];
+  const error = new Error('temporary');
+  const result = await retry(async attempt => {
+    attempts.push(attempt);
+    if (attempt < 3) throw error;
+    return 'done';
+  }, {
+    wait: async (attempt, receivedError) => waits.push([attempt, receivedError])
+  });
+
+  assert.equal(result, 'done');
+  assert.deepEqual(attempts, [1, 2, 3]);
+  assert.deepEqual(waits, [[1, error], [2, error]]);
+});
+
+test('last failure is rethrown without consulting retry hooks', async () => {
+  const error = new Error('final');
+  await assert.rejects(
+    retry(() => { throw error; }, {
+      attempts: 1,
+      shouldRetry: () => { throw new Error('should not run'); },
+      wait: () => { throw new Error('should not run'); }
+    }),
+    received => received === error
+  );
+});
+
+test('stops when retry predicate declines and propagates hook errors', async () => {
+  const error = new Error('stop');
+  let calls = 0;
+  await assert.rejects(
+    retry(() => { calls++; throw error; }, {shouldRetry: () => false}),
+    received => received === error
+  );
+  assert.equal(calls, 1);
+
+  const hookError = new Error('hook');
+  await assert.rejects(
+    retry(() => { throw error; }, {shouldRetry: () => { throw hookError; }}),
+    received => received === hookError
+  );
+});
+
+test('rejects invalid attempts before invoking operation', async () => {
+  for (const attempts of [0, -1, 1.5, NaN, Infinity, '3']) {
+    let called = false;
+    await assert.rejects(
+      retry(() => { called = true; }, {attempts}),
+      RangeError
+    );
+    assert.equal(called, false);
+  }
+});
+
+test('fetchOnce', async () => {
+  assert.equal(await fetchOnce(x => x, 'local'), 'local');
+});
+
+test('fetchWithRetry forwards options while retrying fetcher calls', async () => {
+  let calls = 0;
+  assert.equal(await fetchWithRetry(() => {
+    calls++;
+    if (calls === 1) throw new Error('retry');
+    return 'local';
+  }, 'local', {attempts: 2}), 'local');
+  assert.equal(calls, 2);
+});
