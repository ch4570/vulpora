+const {retry} = require('./retry.js');
+
+async function fetchOnce(fetcher, url) {
+  return fetcher(url);
+}
+
+async function fetchWithRetry(fetcher, url, options) {
+  return retry(() => fetcher(url), options);
+}
+
+module.exports = {fetchOnce, fetchWithRetry};
diff --git a/src/retry.js b/src/retry.js
index 91d1837..f7bb0f7 100644
--- a/src/retry.js
+++ b/src/retry.js
@@ -1,3 +1,26 @@
 'use strict';
-async function retry(operation){return operation(1);}
-module.exports={retry};
+
+async function retry(operation, options = {}) {
+  const {
+    attempts = 3,
+    shouldRetry = () => true,
+    wait = async () => {}
+  } = options;
+
+  if (typeof attempts !== 'number' || !Number.isFinite(attempts) ||
+      !Number.isInteger(attempts) || attempts <= 0) {
+    throw new RangeError('attempts must be a positive integer');
+  }
+
+  for (let attempt = 1; attempt <= attempts; attempt++) {
+    try {
+      return await operation(attempt);
+    } catch (error) {
+      if (attempt === attempts) throw error;
+      if (!shouldRetry(error, attempt)) throw error;
+      await wait(attempt, error);
+    }
+  }
+}
+
+module.exports = {retry};
