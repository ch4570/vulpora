--- a/test/search.test.js
+++ b/test/search.test.js
@@ -1,4 +1,19 @@
 'use strict';
 const test=require('node:test'),assert=require('node:assert/strict');
+const {queryPairs}=require('../src/query.js');
 const {buildSearch}=require('../src/search.js');
 test('basic',()=>assert.equal(buildSearch({q:'term'}),'?q=term'));
+test('queryPairs preserves supported values and expands arrays',()=>{
+  const filters={a:0,b:false,c:'',d:['x',null,2,undefined],e:null,f:undefined};
+  assert.deepEqual(queryPairs(filters),[['a','0'],['b','false'],['c',''],['d','x'],['d','2']]);
+});
+test('queryPairs ignores unsupported values without mutation',()=>{
+  const nested=['kept', ['ignored']];
+  const filters={object:{x:1},fn:()=>{},symbol:Symbol('x'),bigint:1n,nested};
+  assert.deepEqual(queryPairs(filters),[['nested','kept']]);
+  assert.deepEqual(filters.nested,nested);
+});
+test('buildSearch encodes repeated pairs and returns empty when none remain',()=>{
+  assert.equal(buildSearch({q:'a b&c',tag:['x/y','z']}),'?q=a+b%26c&tag=x%2Fy&tag=z');
+  assert.equal(buildSearch({a:null,b:undefined,c:{}}),'');
+});
