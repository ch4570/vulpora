 'use strict';
 const test=require('node:test'),assert=require('node:assert/strict');
+const {queryPairs}=require('../src/query.js');
 const {buildSearch}=require('../src/search.js');
 test('basic',()=>assert.equal(buildSearch({q:'term'}),'?q=term'));
+test('queryPairs preserves order and scalar falsy values',()=>{
+  assert.deepEqual(queryPairs({a:0,b:false,c:'',d:null,e:undefined}),[
+    ['a','0'],['b','false'],['c','']
+  ]);
+});
+test('queryPairs expands arrays and ignores unsupported values',()=>{
+  const filters={a:['x',0,false,'',null,undefined,{x:1},['nested']],b:{x:1},c:()=>{},d:Symbol('d'),e:1n};
+  assert.deepEqual(queryPairs(filters),[
+    ['a','x'],['a','0'],['a','false'],['a','']
+  ]);
+  assert.deepEqual(filters.a,['x',0,false,'',null,undefined,{x:1},['nested']]);
+});
+test('buildSearch URL-encodes repeated pairs and returns empty when none remain',()=>{
+  assert.equal(buildSearch({q:'a b&c',tag:['x/y','z'],zero:0,flag:false}),'?q=a+b%26c&tag=x%2Fy&tag=z&zero=0&flag=false');
+  assert.equal(buildSearch({object:{x:1},nil:null,empty:undefined}), '');
+});
