diff --git a/src/retry.js b/src/retry.js
index 91d1837..c955f4b 100644
--- a/src/retry.js
+++ b/src/retry.js
@@ -1,3 +1,29 @@
 'use strict';
-async function retry(operation){return operation(1);}
+async function retry(operation, options = {}) {
+  const {
+    attempts = 3,
+    shouldRetry = () => true,
+    wait = async () => {},
+  } = options;
+
+  if (!Number.isFinite(attempts) || !Number.isInteger(attempts) || attempts <= 0) {
+    throw new RangeError('attempts must be a positive integer');
+  }
+
+  for (let attempt = 1; attempt <= attempts; attempt += 1) {
+    try {
+      return await operation(attempt);
+    } catch (error) {
+      if (attempt === attempts) {
+        throw error;
+      }
+
+      if (!shouldRetry(error, attempt)) {
+        throw error;
+      }
+
+      await wait(attempt, error);
+    }
+  }
+}
 module.exports={retry};
diff --git a/test/retry.test.js b/test/retry.test.js
index fc01914..5bf029d 100644
--- a/test/retry.test.js
+++ b/test/retry.test.js
@@ -2,6 +2,71 @@
 const test=require('node:test');
 const assert=require('node:assert/strict');
 const {retry}=require('../src/retry.js');
-const {fetchOnce}=require('../src/client.js');
+const {fetchOnce,fetchWithRetry}=require('../src/client.js');
 test('immediate success',async()=>assert.equal(await retry(()=>7),7));
 test('fetchOnce',async()=>assert.equal(await fetchOnce(x=>x,'local'), 'local'));
+
+test('retries failures with one-based attempt numbers and waits between calls', async () => {
+  const calls=[];
+  const waits=[];
+  const value=await retry(attempt => {
+    calls.push(attempt);
+    if (attempt < 3) throw new Error(`failure ${attempt}`);
+    return 'done';
+  }, {wait: async (attempt, error) => waits.push([attempt, error.message])});
+  assert.equal(value, 'done');
+  assert.deepEqual(calls, [1,2,3]);
+  assert.deepEqual(waits, [[1,'failure 1'],[2,'failure 2']]);
+});
+
+test('does not consult retry hooks after the final failure', async () => {
+  const error=new Error('final');
+  await assert.rejects(
+    retry(() => { throw error; }, {
+      attempts: 1,
+      shouldRetry: () => { throw new Error('should not run'); },
+      wait: () => { throw new Error('should not run'); },
+    }),
+    received => received === error,
+  );
+});
+
+test('stops on a false predicate and propagates hook errors', async () => {
+  const failure=new Error('failure');
+  let calls=0;
+  await assert.rejects(retry(() => { calls+=1; throw failure; }, {
+    shouldRetry: (error, attempt) => {
+      assert.equal(error, failure);
+      assert.equal(attempt, 1);
+      return false;
+    },
+  }), received => received === failure);
+  assert.equal(calls, 1);
+
+  const hookError=new Error('hook');
+  await assert.rejects(retry(() => Promise.reject(failure), {
+    shouldRetry: () => { throw hookError; },
+  }), received => received === hookError);
+  await assert.rejects(retry(() => { throw failure; }, {
+    wait: () => { throw hookError; },
+  }), received => received === hookError);
+});
+
+test('rejects invalid attempt counts before invoking the operation', async () => {
+  for (const attempts of [0,-1,1.5,NaN,Infinity,'3',null]) {
+    let called=false;
+    await assert.rejects(retry(() => { called=true; }, {attempts}), RangeError);
+    assert.equal(called, false);
+  }
+});
+
+test('fetchWithRetry retries fetcher calls and forwards options', async () => {
+  let calls=0;
+  const value=await fetchWithRetry(url => {
+    calls+=1;
+    if (calls === 1) throw new Error('temporary');
+    return url;
+  }, 'local', {attempts:2});
+  assert.equal(value, 'local');
+  assert.equal(calls, 2);
+});
