+++ b/test/retry.test.js
@@ -1,7 +1,110 @@
 'use strict';
-const test=require('node:test');
-const assert=require('node:assert/strict');
-const {retry}=require('../src/retry.js');
-const {fetchOnce}=require('../src/client.js');
-test('immediate success',async()=>assert.equal(await retry(()=>7),7));
-test('fetchOnce',async()=>assert.equal(await fetchOnce(x=>x,'local'), 'local'));
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const {retry} = require('../src/retry.js');
+const {fetchOnce, fetchWithRetry} = require('../src/client.js');
+
+test('immediate success', async () => {
+  assert.equal(await retry(() => 7), 7);
+});
+
+test('retries synchronous throws and passes one-based attempt numbers', async () => {
+  const attempts = [];
+  const value = await retry(attempt => {
+    attempts.push(attempt);
+    if (attempt < 3) throw new Error('try again');
+    return 'done';
+  });
+  assert.equal(value, 'done');
+  assert.deepEqual(attempts, [1, 2, 3]);
+});
+
+test('retries async rejections and awaits wait with attempt and error', async () => {
+  const error = new Error('temporary');
+  const calls = [];
+  const value = await retry(async attempt => {
+    if (attempt === 1) throw error;
+    return 'ok';
+  }, {
+    attempts: 2,
+    shouldRetry: async (received, attempt) => {
+      calls.push(['retry', received, attempt]);
+      return true;
+    },
+    wait: async (attempt, received) => calls.push(['wait', attempt, received])
+  });
+  assert.equal(value, 'ok');
+  assert.deepEqual(calls, [['retry', error, 1], ['wait', 1, error]]);
+});
+
+test('does not retry when shouldRetry returns false', async () => {
+  const error = new Error('stop');
+  let waits = 0;
+  await assert.rejects(
+    retry(() => { throw error; }, {
+      shouldRetry: () => false,
+      wait: () => { waits += 1; }
+    }),
+    received => received === error
+  );
+  assert.equal(waits, 0);
+});
+
+test('last failure is rethrown without predicate or wait', async () => {
+  const error = new Error('last');
+  let predicates = 0;
+  let waits = 0;
+  await assert.rejects(
+    retry(() => Promise.reject(error), {
+      attempts: 1,
+      shouldRetry: () => { predicates += 1; return true; },
+      wait: () => { waits += 1; }
+    }),
+    received => received === error
+  );
+  assert.equal(predicates, 0);
+  assert.equal(waits, 0);
+});
+
+test('rejects invalid attempts before running operation', async () => {
+  for (const attempts of [0, -1, 1.5, Infinity, NaN, '3']) {
+    let called = false;
+    await assert.rejects(
+      retry(() => { called = true; }, {attempts}),
+      RangeError
+    );
+    assert.equal(called, false);
+  }
+});
+
+test('predicate and wait errors stop retries', async () => {
+  const predicateError = new Error('predicate');
+  const waitError = new Error('wait');
+  await assert.rejects(
+    retry(() => { throw new Error('operation'); }, {
+      shouldRetry: () => { throw predicateError; }
+    }),
+    received => received === predicateError
+  );
+  await assert.rejects(
+    retry(() => { throw new Error('operation'); }, {
+      wait: () => { throw waitError; }
+    }),
+    received => received === waitError
+  );
+});
+
+test('fetchWithRetry forwards options and fetches the requested URL', async () => {
+  let calls = 0;
+  assert.equal(await fetchWithRetry(url => {
+    calls += 1;
+    if (calls === 1) throw new Error('temporary');
+    return url;
+  }, 'local', {attempts: 2}), 'local');
+  assert.equal(calls, 2);
+});
+
+test('fetchOnce', async () => {
+  assert.equal(await fetchOnce(x => x, 'local'), 'local');
+});
