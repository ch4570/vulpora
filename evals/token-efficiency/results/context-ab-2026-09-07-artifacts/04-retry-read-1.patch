diff --git a/src/retry.js b/src/retry.js
index 91d1837..31c919e 100644
--- a/src/retry.js
+++ b/src/retry.js
@@ -1,3 +1,34 @@
 'use strict';
-async function retry(operation){return operation(1);}
+async function retry(operation, options = {}) {
+  const {
+    attempts = 3,
+    shouldRetry = () => true,
+    wait = async () => {},
+  } = options;
+
+  if (
+    typeof attempts !== 'number' ||
+    !Number.isFinite(attempts) ||
+    !Number.isInteger(attempts) ||
+    attempts <= 0
+  ) {
+    throw new RangeError('attempts must be a positive finite integer');
+  }
+
+  for (let attempt = 1; attempt <= attempts; attempt += 1) {
+    try {
+      return await operation(attempt);
+    } catch (error) {
+      if (attempt === attempts) {
+        throw error;
+      }
+
+      if (!(await shouldRetry(error, attempt))) {
+        throw error;
+      }
+
+      await wait(attempt, error);
+    }
+  }
+}
 module.exports={retry};
diff --git a/test/retry.test.js b/test/retry.test.js
index fc01914..2525d20 100644
--- a/test/retry.test.js
+++ b/test/retry.test.js
@@ -2,6 +2,89 @@
 const test=require('node:test');
 const assert=require('node:assert/strict');
 const {retry}=require('../src/retry.js');
-const {fetchOnce}=require('../src/client.js');
+const {fetchOnce,fetchWithRetry}=require('../src/client.js');
 test('immediate success',async()=>assert.equal(await retry(()=>7),7));
 test('fetchOnce',async()=>assert.equal(await fetchOnce(x=>x,'local'), 'local'));
+
+test('retries failures and returns the first successful value',async()=>{
+  const calls=[];
+  const waits=[];
+  const value=await retry(attempt=>{
+    calls.push(attempt);
+    if(attempt<3) throw new Error('try again');
+    return {attempt};
+  },{wait:(attempt,error)=>waits.push([attempt,error.message])});
+  assert.deepEqual(calls,[1,2,3]);
+  assert.deepEqual(waits,[[1,'try again'],[2,'try again']]);
+  assert.deepEqual(value,{attempt:3});
+});
+
+test('attempts counts total calls and does not consult hooks after the last failure',async()=>{
+  const error=new Error('final');
+  let shouldRetryCalls=0;
+  let waitCalls=0;
+  await assert.rejects(
+    retry(()=>{throw error;},{attempts:2,shouldRetry:()=>{shouldRetryCalls+=1;return true;},wait:()=>{waitCalls+=1;}}),
+    received=>received===error,
+  );
+  assert.equal(shouldRetryCalls,1);
+  assert.equal(waitCalls,1);
+});
+
+test('stops with the original error when shouldRetry declines',async()=>{
+  const error=new Error('stop');
+  const waits=[];
+  await assert.rejects(
+    retry(()=>Promise.reject(error),{shouldRetry:(received,attempt)=>{
+      assert.equal(received,error);
+      assert.equal(attempt,1);
+      return false;
+    },wait:attempt=>waits.push(attempt)}),
+    received=>received===error,
+  );
+  assert.deepEqual(waits,[]);
+});
+
+test('propagates errors from retry hooks without another operation call',async()=>{
+  const hookError=new Error('hook failure');
+  let calls=0;
+  await assert.rejects(
+    retry(()=>{calls+=1;throw new Error('operation failure');},{shouldRetry:()=>{throw hookError;}}),
+    received=>received===hookError,
+  );
+  assert.equal(calls,1);
+});
+
+test('propagates errors from wait without another operation call',async()=>{
+  const waitError=new Error('wait failure');
+  let calls=0;
+  await assert.rejects(
+    retry(()=>{calls+=1;throw new Error('operation failure');},{wait:async()=>{throw waitError;}}),
+    received=>received===waitError,
+  );
+  assert.equal(calls,1);
+});
+
+test('rejects invalid attempts before running the operation',async()=>{
+  for(const attempts of ['3', 1.5, 0, -1, Infinity, NaN]){
+    let calls=0;
+    await assert.rejects(
+      retry(()=>{calls+=1;},{attempts}),
+      RangeError,
+    );
+    assert.equal(calls,0);
+  }
+});
+
+test('fetchWithRetry forwards options and retries fetcher(url)',async()=>{
+  const urls=[];
+  let waits=0;
+  const result=await fetchWithRetry(url=>{
+    urls.push(url);
+    if(urls.length===1) throw new Error('temporary');
+    return 'response';
+  },'local',{attempts:2,wait:()=>{waits+=1;}});
+  assert.equal(result,'response');
+  assert.deepEqual(urls,['local','local']);
+  assert.equal(waits,1);
+});
