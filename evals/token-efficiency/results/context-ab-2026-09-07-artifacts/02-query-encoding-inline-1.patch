diff --git a/src/query.js b/src/query.js
index ccd7d9e..bc8bbe9 100644
--- a/src/query.js
+++ b/src/query.js
@@ -1,3 +1,15 @@
 'use strict';
-function queryPairs(filters){return Object.entries(filters).filter(([,value])=>value).map(([key,value])=>[key,String(value)]);}
+function queryPairs(filters){
+  const pairs=[];
+  for(const [key,value] of Object.entries(filters)){
+    const values=Array.isArray(value)?value:[value];
+    for(const item of values){
+      if(item===null||item===undefined)continue;
+      if(typeof item==='string'||typeof item==='number'||typeof item==='boolean'){
+        pairs.push([key,String(item)]);
+      }
+    }
+  }
+  return pairs;
+}
 module.exports={queryPairs};
diff --git a/src/search.js b/src/search.js
index 65f12d1..9e8c872 100644
--- a/src/search.js
+++ b/src/search.js
@@ -1,3 +1,7 @@
 'use strict';
-function buildSearch(filters){return '?'+Object.entries(filters).map(([key,value])=>key+'='+value).join('&');}
+const {queryPairs}=require('./query.js');
+function buildSearch(filters){
+  const query=new URLSearchParams(queryPairs(filters)).toString();
+  return query?'?'+query:'';
+}
 module.exports={buildSearch};
diff --git a/test/search.test.js b/test/search.test.js
index ca55db6..7f43bef 100644
--- a/test/search.test.js
+++ b/test/search.test.js
@@ -1,4 +1,24 @@
 'use strict';
 const test=require('node:test'),assert=require('node:assert/strict');
+const {queryPairs}=require('../src/query.js');
 const {buildSearch}=require('../src/search.js');
 test('basic',()=>assert.equal(buildSearch({q:'term'}),'?q=term'));
+test('queryPairs preserves supported scalars and entry order',()=>{
+  assert.deepEqual(queryPairs({zero:0,no:false,empty:'',term:'x'}),[
+    ['zero','0'],['no','false'],['empty',''],['term','x']
+  ]);
+});
+test('queryPairs expands arrays and omits nullish values',()=>{
+  const filters={tag:['a',null,'b',undefined,0],other:null};
+  const tags=filters.tag;
+  assert.deepEqual(queryPairs(filters),[['tag','a'],['tag','b'],['tag','0']]);
+  assert.strictEqual(filters.tag,tags);
+  assert.deepEqual(tags,['a',null,'b',undefined,0]);
+});
+test('queryPairs ignores unsupported and nested values',()=>{
+  assert.deepEqual(queryPairs({object:{x:1},fn:()=>1,symbol:Symbol('x'),big:1n,nested:[['x'],true]}),[['nested','true']]);
+});
+test('buildSearch encodes pairs and is empty without pairs',()=>{
+  assert.equal(buildSearch({q:'a b',tag:['x&y','z'],zero:0,no:false}),'?q=a+b&tag=x%26y&tag=z&zero=0&no=false');
+  assert.equal(buildSearch({missing:null,ignored:{}}),'');
+});
