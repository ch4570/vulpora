 'use strict';
 const test=require('node:test'),assert=require('node:assert/strict');
+const {queryPairs}=require('../src/query.js');
 const {buildSearch}=require('../src/search.js');
 test('basic',()=>assert.equal(buildSearch({q:'term'}),'?q=term'));
+test('queryPairs preserves scalar values and entry order',()=>assert.deepEqual(queryPairs({zero:0,no:false,empty:'',skip:null,missing:undefined,last:1}),[['zero','0'],['no','false'],['empty',''],['last','1']]));
+test('queryPairs expands arrays and omits unsupported values',()=>{
+  const filters={tags:['a',null,0,false,'',undefined],object:{},fn:()=>{},symbol:Symbol('x'),bigint:1n,nested:[[1]],valid:true};
+  assert.deepEqual(queryPairs(filters),[['tags','a'],['tags','0'],['tags','false'],['tags',''],['valid','true']]);
+});
+test('queryPairs does not mutate filters or arrays',()=>{
+  const tags=['a',null,2],filters={tags};
+  assert.deepEqual(queryPairs(filters),[['tags','a'],['tags','2']]);
+  assert.deepEqual(tags,['a',null,2]);
+  assert.deepEqual(filters,{tags:['a',null,2]});
+});
+test('buildSearch encodes pairs and is empty when none remain',()=>{
+  assert.equal(buildSearch({q:'a b&c',tag:['x/y','']}), '?q=a+b%26c&tag=x%2Fy&tag=');
+  assert.equal(buildSearch({null:null,object:{},nested:[[1]]}), '');
+});
