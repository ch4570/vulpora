diff --git a/src/retry.js b/src/retry.js
index 91d1837..5979052 100644
--- a/src/retry.js
+++ b/src/retry.js
@@ -1,3 +1,34 @@
 'use strict';
-async function retry(operation){return operation(1);}
+async function retry(operation, options = {}) {
+  const {
+    attempts = 3,
+    shouldRetry = () => true,
+    wait = async () => {},
+  } = options;
+
+  if (
+    typeof attempts !== 'number' ||
+    !Number.isFinite(attempts) ||
+    !Number.isInteger(attempts) ||
+    attempts <= 0
+  ) {
+    throw new RangeError('attempts must be a positive integer');
+  }
+
+  for (let attempt = 1; attempt <= attempts; attempt += 1) {
+    try {
+      return await operation(attempt);
+    } catch (error) {
+      if (attempt === attempts) {
+        throw error;
+      }
+
+      if (!(await shouldRetry(error, attempt))) {
+        throw error;
+      }
+
+      await wait(attempt, error);
+    }
+  }
+}
 module.exports={retry};
diff --git a/test/retry.test.js b/test/retry.test.js
index fc01914..f7ae4f8 100644
--- a/test/retry.test.js
+++ b/test/retry.test.js
@@ -2,6 +2,80 @@
 const test=require('node:test');
 const assert=require('node:assert/strict');
 const {retry}=require('../src/retry.js');
-const {fetchOnce}=require('../src/client.js');
+const {fetchOnce,fetchWithRetry}=require('../src/client.js');
 test('immediate success',async()=>assert.equal(await retry(()=>7),7));
 test('fetchOnce',async()=>assert.equal(await fetchOnce(x=>x,'local'), 'local'));
+
+test('retries failures and passes one-based attempt numbers',async()=>{
+  const calls=[];
+  const waits=[];
+  const value=await retry(attempt=>{
+    calls.push(attempt);
+    if(attempt<3)throw new Error('not yet');
+    return 'done';
+  },{wait:(attempt,error)=>waits.push([attempt,error.message])});
+  assert.equal(value,'done');
+  assert.deepEqual(calls,[1,2,3]);
+  assert.deepEqual(waits,[[1,'not yet'],[2,'not yet']]);
+});
+
+test('uses three total calls by default',async()=>{
+  let calls=0;
+  const error=new Error('failed');
+  await assert.rejects(retry(()=>{calls+=1;throw error;}),caught=>caught===error);
+  assert.equal(calls,3);
+});
+
+test('does not consult retry hooks after the final failure',async()=>{
+  const error=new Error('final');
+  let predicateCalls=0;
+  let waitCalls=0;
+  await assert.rejects(retry(()=>{throw error;},{attempts:1,shouldRetry:()=>{predicateCalls+=1;return true;},wait:()=>{waitCalls+=1;}}),caught=>caught===error);
+  assert.equal(predicateCalls,0);
+  assert.equal(waitCalls,0);
+});
+
+test('stops when shouldRetry declines and preserves the error',async()=>{
+  const error=new Error('stop');
+  let calls=0;
+  let waitCalls=0;
+  await assert.rejects(retry(()=>{calls+=1;throw error;},{shouldRetry:(caught,attempt)=>{
+    assert.equal(caught,error);
+    assert.equal(attempt,1);
+    return false;
+  },wait:()=>{waitCalls+=1;}}),caught=>caught===error);
+  assert.equal(calls,1);
+  assert.equal(waitCalls,0);
+});
+
+test('propagates predicate and wait errors without another operation call',async()=>{
+  const operationError=new Error('operation');
+  const predicateError=new Error('predicate');
+  let calls=0;
+  await assert.rejects(retry(()=>{calls+=1;throw operationError;},{shouldRetry:()=>{throw predicateError;}}),caught=>caught===predicateError);
+  assert.equal(calls,1);
+
+  const waitError=new Error('wait');
+  calls=0;
+  await assert.rejects(retry(()=>{calls+=1;return Promise.reject(operationError);},{wait:()=>Promise.reject(waitError)}),caught=>caught===waitError);
+  assert.equal(calls,1);
+});
+
+test('rejects invalid attempts before calling the operation',async()=>{
+  for(const attempts of [0,-1,1.5,NaN,Infinity,'3',null]){
+    let calls=0;
+    await assert.rejects(retry(()=>{calls+=1;},{attempts}),RangeError);
+    assert.equal(calls,0);
+  }
+});
+
+test('fetchWithRetry forwards options while retrying fetcher(url)',async()=>{
+  const urls=[];
+  const value=await fetchWithRetry(url=>{
+    urls.push(url);
+    if(urls.length===1)throw new Error('temporary');
+    return 'response';
+  },'local',{attempts:2});
+  assert.equal(value,'response');
+  assert.deepEqual(urls,['local','local']);
+});
