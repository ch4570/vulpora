diff --git a/src/retry.js b/src/retry.js
index 91d1837..665717d 100644
--- a/src/retry.js
+++ b/src/retry.js
@@ -1,3 +1,26 @@
 'use strict';
-async function retry(operation){return operation(1);}
+
+async function retry(operation, options = {}) {
+  const {
+    attempts = 3,
+    shouldRetry = () => true,
+    wait = async () => {},
+  } = options;
+
+  if (typeof attempts !== 'number' || !Number.isFinite(attempts) ||
+      !Number.isInteger(attempts) || attempts <= 0) {
+    throw new RangeError('attempts must be a positive finite integer');
+  }
+
+  for (let attempt = 1; attempt <= attempts; attempt += 1) {
+    try {
+      return await operation(attempt);
+    } catch (error) {
+      if (attempt === attempts) throw error;
+      if (!await shouldRetry(error, attempt)) throw error;
+      await wait(attempt, error);
+    }
+  }
+}
+
 module.exports={retry};
diff --git a/test/retry.test.js b/test/retry.test.js
index fc01914..5e914d2 100644
--- a/test/retry.test.js
+++ b/test/retry.test.js
@@ -2,6 +2,75 @@
 const test=require('node:test');
 const assert=require('node:assert/strict');
 const {retry}=require('../src/retry.js');
-const {fetchOnce}=require('../src/client.js');
+const {fetchOnce,fetchWithRetry}=require('../src/client.js');
 test('immediate success',async()=>assert.equal(await retry(()=>7),7));
 test('fetchOnce',async()=>assert.equal(await fetchOnce(x=>x,'local'), 'local'));
+
+test('retries failures and returns the first successful value',async()=>{
+  const calls=[];
+  const value=await retry(attempt=>{
+    calls.push(attempt);
+    if(attempt<3) throw new Error('temporary');
+    return {attempt};
+  },{wait:async()=>{}});
+  assert.deepEqual(calls,[1,2,3]);
+  assert.deepEqual(value,{attempt:3});
+});
+
+test('rejects invalid attempts before running the operation',async()=>{
+  for(const attempts of [0,-1,1.5,Infinity,NaN,'3']){
+    let called=false;
+    await assert.rejects(retry(()=>{called=true;},{attempts}),RangeError);
+    assert.equal(called,false);
+  }
+});
+
+test('does not consult retry hooks after the final failure',async()=>{
+  const error=new Error('last failure');
+  let predicateCalls=0;
+  let waitCalls=0;
+  await assert.rejects(
+    retry(()=>{throw error;},{attempts:1,shouldRetry:()=>{predicateCalls+=1;},wait:()=>{waitCalls+=1;}}),
+    received=>received===error,
+  );
+  assert.equal(predicateCalls,0);
+  assert.equal(waitCalls,0);
+});
+
+test('stops when shouldRetry declines and passes attempt details to hooks',async()=>{
+  const error=new Error('stop');
+  const predicateCalls=[];
+  let waited=false;
+  await assert.rejects(
+    retry(()=>Promise.reject(error),{
+      attempts:3,
+      shouldRetry:(received,attempt)=>{predicateCalls.push([received,attempt]);return false;},
+      wait:()=>{waited=true;},
+    }),
+    received=>received===error,
+  );
+  assert.deepEqual(predicateCalls,[[error,1]]);
+  assert.equal(waited,false);
+});
+
+test('propagates retry hook failures without another operation call',async()=>{
+  const operationError=new Error('operation');
+  const predicateError=new Error('predicate');
+  let calls=0;
+  await assert.rejects(
+    retry(()=>{calls+=1;throw operationError;},{shouldRetry:()=>{throw predicateError;}}),
+    received=>received===predicateError,
+  );
+  assert.equal(calls,1);
+});
+
+test('fetchWithRetry retries fetcher calls and forwards options',async()=>{
+  let calls=0;
+  const result=await fetchWithRetry(url=>{
+    calls+=1;
+    if(calls===1) return Promise.reject(new Error('temporary'));
+    return url;
+  },'local',{attempts:2});
+  assert.equal(result,'local');
+  assert.equal(calls,2);
+});
