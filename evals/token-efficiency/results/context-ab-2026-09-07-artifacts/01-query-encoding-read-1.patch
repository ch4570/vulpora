 'use strict';
 const test=require('node:test'),assert=require('node:assert/strict');
 const {buildSearch}=require('../src/search.js');
-test('basic',()=>assert.equal(buildSearch({q:'term'}),'?q=term'));
+const {queryPairs}=require('../src/query.js');
+
+test('queryPairs serializes supported values in entry and array order',()=>{
+  const filters={q:'term',page:0,enabled:false,empty:'',tags:['a',null,'b',undefined]};
+  assert.deepEqual(queryPairs(filters),[
+    ['q','term'],['page','0'],['enabled','false'],['empty',''],['tags','a'],['tags','b']
+  ]);
+});
+
+test('queryPairs ignores unsupported values without mutating filters',()=>{
+  const tags=['a',null,'b'];
+  const filters={object:{},fn:()=>{},symbol:Symbol('x'),bigint:1n,nested:[['x']],tags};
+  assert.deepEqual(queryPairs(filters),[['tags','a'],['tags','b']]);
+  assert.deepEqual(filters.tags,tags);
+});
+
+test('buildSearch uses URL encoding and repeated keys',()=>{
+  assert.equal(buildSearch({q:'a b&c',tag:['one','two']}),'?q=a+b%26c&tag=one&tag=two');
+});
+
+test('buildSearch returns empty string when no pairs remain',()=>{
+  assert.equal(buildSearch({zero:0,falseValue:false,empty:'',missing:null}),'?zero=0&falseValue=false&empty=');
+  assert.equal(buildSearch({object:{},missing:null}), '');
+});
