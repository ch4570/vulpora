-test('basic',()=>assert.equal(buildSearch({q:'term'}),'?q=term'));
+const {queryPairs}=require('../src/query.js');
+
+test('queryPairs serializes supported scalar values in entry order',()=>{
+  assert.deepEqual(queryPairs({q:'term',page:0,enabled:false,empty:''}),[
+    ['q','term'],['page','0'],['enabled','false'],['empty','']
+  ]);
+});
+
+test('queryPairs expands arrays and omits unsupported values',()=>{
+  const filters={a:[1,null,false,undefined,['nested'],''],b:null,c:undefined,d:{x:1},e:()=>{},f:Symbol('x'),g:1n};
+  assert.deepEqual(queryPairs(filters),[['a','1'],['a','false'],['a','']]);
+  assert.deepEqual(filters.a,[1,null,false,undefined,['nested'],'']);
+});
+
+test('buildSearch encodes repeated pairs and returns empty when no pairs remain',()=>{
+  assert.equal(buildSearch({q:'a b',tag:['x&y',''],page:0}),'?q=a+b&tag=x%26y&tag=&page=0');
+  assert.equal(buildSearch({a:null,b:undefined,c:{}}),'');
+});
