 'use strict';
 const test=require('node:test'),assert=require('node:assert/strict');
+const {queryPairs}=require('../src/query.js');
 const {buildSearch}=require('../src/search.js');
-test('basic',()=>assert.equal(buildSearch({q:'term'}),'?q=term'));
+
+test('queryPairs preserves supported scalars and entry order',()=>{
+  assert.deepEqual(queryPairs({q:'term',page:0,enabled:false,empty:'',ignored:null}),[
+    ['q','term'],['page','0'],['enabled','false'],['empty','']
+  ]);
+});
+
+test('queryPairs expands arrays and ignores unsupported values',()=>{
+  const filters={tag:['one',null,0,false,undefined,['nested']], object:{}, fn:()=>{}, symbol:Symbol('x'), big:1n};
+  const tags=filters.tag;
+  assert.deepEqual(queryPairs(filters),[['tag','one'],['tag','0'],['tag','false']]);
+  assert.strictEqual(filters.tag,tags);
+  assert.deepEqual(filters.tag,['one',null,0,false,undefined,['nested']]);
+});
+
+test('buildSearch URL-encodes repeated query pairs',()=>{
+  assert.equal(buildSearch({q:'a b&c',tag:['x/y',''] }),'?q=a+b%26c&tag=x%2Fy&tag=');
+});
+
+test('buildSearch returns empty string when no pairs remain',()=>{
+  assert.equal(buildSearch({a:null,b:undefined,c:{}}),'');
+});
