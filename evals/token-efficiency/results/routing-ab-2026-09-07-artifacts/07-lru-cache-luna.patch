+  constructor(capacity) {
+    if (typeof capacity !== 'number' || !Number.isInteger(capacity) || capacity <= 0) {
+      throw new RangeError('capacity must be a positive integer');
+    }
+    this.capacity = capacity;
+    this.items = new Map();
+  }
+
+  set(key, value) {
+    if (this.items.has(key)) {
+      this.items.delete(key);
+    } else if (this.items.size >= this.capacity) {
+      this.items.delete(this.items.keys().next().value);
+    }
+    this.items.set(key, value);
+    return this;
+  }
+
+  get(key) {
+    if (!this.items.has(key)) return undefined;
+    const value = this.items.get(key);
+    this.items.delete(key);
+    this.items.set(key, value);
+    return value;
+  }
+
+  has(key) {
+    return this.items.has(key);
+  }
+
+  get size() {
+    return this.items.size;
+  }
 }
-module.exports={LRUCache};
+
+module.exports = {LRUCache};
diff --git a/test/lru.test.js b/test/lru.test.js
index 04e9b01..ef9d44c 100644
--- a/test/lru.test.js
+++ b/test/lru.test.js
@@ -3,3 +3,67 @@ const test=require('node:test');
 const assert=require('node:assert/strict');
 const {LRUCache}=require('../src/lru.js');
 test('stores a value',()=>{const c=new LRUCache(2);c.set('a',1);assert.equal(c.get('a'),1);});
+
+test('rejects invalid capacities',()=>{
+  for (const capacity of [0,-1,1.5,NaN,Infinity,'2',null,undefined]) {
+    assert.throws(()=>new LRUCache(capacity),RangeError);
+  }
+});
+
+test('stores falsy and undefined values',()=>{
+  const c=new LRUCache(6);
+  for (const [key,value] of [['false',false],['zero',0],['empty',''],['null',null],['undefined',undefined]]) c.set(key,value);
+  assert.equal(c.get('false'),false);
+  assert.equal(c.get('zero'),0);
+  assert.equal(c.get('empty'),'');
+  assert.equal(c.get('null'),null);
+  assert.equal(c.get('undefined'),undefined);
+  assert.equal(c.size,5);
+});
+
+test('refreshes recency on insert, update, and hit',()=>{
+  const c=new LRUCache(2);
+  assert.strictEqual(c.set('a',1),c);
+  c.set('b',2).set('a',3).set('c',4);
+  assert.equal(c.has('a'),true);
+  assert.equal(c.has('b'),false);
+  assert.equal(c.get('a'),3);
+  c.set('d',4);
+  assert.equal(c.has('a'),true);
+  assert.equal(c.has('c'),false);
+});
+
+test('get misses do not refresh recency',()=>{
+  const c=new LRUCache(2);
+  c.set('a',1).set('b',2);
+  assert.equal(c.get('missing'),undefined);
+  c.set('c',3);
+  assert.equal(c.has('a'),false);
+  assert.equal(c.has('b'),true);
+});
+
+test('has and size do not refresh recency',()=>{
+  const c=new LRUCache(2);
+  c.set('a',1).set('b',2);
+  assert.equal(c.has('a'),true);
+  assert.equal(c.size,2);
+  c.set('c',3);
+  assert.equal(c.has('a'),false);
+});
+
+test('supports object identity keys',()=>{
+  const c=new LRUCache(2);
+  const key={};
+  c.set(key,'value');
+  assert.equal(c.has(key),true);
+  assert.equal(c.get(key),'value');
+  assert.equal(c.has({}),false);
+});
+
+test('updating an existing key does not evict another entry',()=>{
+  const c=new LRUCache(2);
+  c.set('a',1).set('b',2).set('a',3);
+  assert.equal(c.size,2);
+  assert.equal(c.get('a'),3);
+  assert.equal(c.get('b'),2);
+});
