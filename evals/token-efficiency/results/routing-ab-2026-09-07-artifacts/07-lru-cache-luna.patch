 'use strict';
 class LRUCache {
-constructor(capacity){this.capacity=capacity;this.items=new Map();}
-set(key,value){if(this.items.size>=this.capacity)this.items.delete(this.items.keys().next().value);this.items.set(key,value);return this;}
