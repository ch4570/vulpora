 'use strict';
 const test=require('node:test'),assert=require('node:assert/strict');
+const {queryPairs}=require('../src/query.js');
 const {buildSearch}=require('../src/search.js');
 test('basic',()=>assert.equal(buildSearch({q:'term'}),'?q=term'));
+test('queryPairs preserves supported values and order',()=>assert.deepEqual(
+  queryPairs({first:'', second:0, third:false, repeated:['a',null,true,undefined,2]}),
+  [['first',''],['second','0'],['third','false'],['repeated','a'],['repeated','true'],['repeated','2']],
+));
+test('queryPairs ignores unsupported values without mutating arrays',()=>{
+  const values=[null,{},()=>{},Symbol('value'),1n,['nested'],false];
+  const original=values.slice();
+  assert.deepEqual(queryPairs({value:values}),[['value','false']]);
+  assert.deepEqual(values,original);
+});
+test('buildSearch encodes repeated values and returns empty when no pairs remain',()=>{
+  assert.equal(buildSearch({q:'a b&c', tag:['one','two']}),'?q=a+b%26c&tag=one&tag=two');
+  assert.equal(buildSearch({nullValue:null, object:{}, nested:[[1]], symbol:Symbol('x')}),'');
+});
