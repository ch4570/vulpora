diff --git a/src/retry.js b/src/retry.js
index 91d1837..3bf1660 100644
--- a/src/retry.js
+++ b/src/retry.js
@@ -1,3 +1,25 @@
 'use strict';
-async function retry(operation){return operation(1);}
+async function retry(operation, options = {}) {
+  const attempts = options.attempts === undefined ? 3 : options.attempts;
+  const shouldRetry = options.shouldRetry === undefined ? () => true : options.shouldRetry;
+  const wait = options.wait === undefined ? async () => {} : options.wait;
+
+  if (typeof attempts !== 'number' || !Number.isFinite(attempts) || !Number.isInteger(attempts) || attempts <= 0) {
+    throw new RangeError('attempts must be a positive finite integer');
+  }
+
+  for (let attempt = 1; attempt <= attempts; attempt += 1) {
+    try {
+      return await operation(attempt);
+    } catch (error) {
+      if (attempt === attempts) {
+        throw error;
+      }
+      if (!(await shouldRetry(error, attempt))) {
+        throw error;
+      }
+      await wait(attempt, error);
+    }
+  }
+}
 module.exports={retry};
diff --git a/test/retry.test.js b/test/retry.test.js
index fc01914..145ed1e 100644
--- a/test/retry.test.js
+++ b/test/retry.test.js
@@ -2,6 +2,91 @@
 const test=require('node:test');
 const assert=require('node:assert/strict');
 const {retry}=require('../src/retry.js');
-const {fetchOnce}=require('../src/client.js');
+const {fetchOnce,fetchWithRetry}=require('../src/client.js');
 test('immediate success',async()=>assert.equal(await retry(()=>7),7));
 test('fetchOnce',async()=>assert.equal(await fetchOnce(x=>x,'local'), 'local'));
+
+test('retries failures with one-based attempts', async () => {
+  const seen = [];
+  const value = await retry(attempt => {
+    seen.push(attempt);
+    if (attempt < 3) throw new Error('try again');
+    return 'done';
+  });
+  assert.equal(value, 'done');
+  assert.deepEqual(seen, [1, 2, 3]);
+});
+
+test('attempts is the total number of calls', async () => {
+  let calls = 0;
+  const error = new Error('failed');
+  await assert.rejects(retry(() => { calls += 1; throw error; }, {attempts: 2}), error);
+  assert.equal(calls, 2);
+});
+
+test('invalid attempts reject before operation runs', async () => {
+  for (const attempts of [0, -1, 1.5, Infinity, NaN, '3', null]) {
+    let called = false;
+    await assert.rejects(retry(() => { called = true; }, {attempts}), RangeError);
+    assert.equal(called, false);
+  }
+});
+
+test('does not retry after shouldRetry declines', async () => {
+  const error = new Error('stop');
+  let calls = 0;
+  let predicateCalls = 0;
+  await assert.rejects(retry(() => { calls += 1; throw error; }, {
+    attempts: 3,
+    shouldRetry: (received, attempt) => {
+      predicateCalls += 1;
+      assert.equal(received, error);
+      assert.equal(attempt, 1);
+      return false;
+    }
+  }), error);
+  assert.equal(calls, 1);
+  assert.equal(predicateCalls, 1);
+});
+
+test('does not call shouldRetry or wait on the last attempt', async () => {
+  const error = new Error('last');
+  let predicateCalls = 0;
+  let waitCalls = 0;
+  await assert.rejects(retry(() => { throw error; }, {
+    attempts: 1,
+    shouldRetry: () => { predicateCalls += 1; },
+    wait: () => { waitCalls += 1; }
+  }), error);
+  assert.equal(predicateCalls, 0);
+  assert.equal(waitCalls, 0);
+});
+
+test('propagates shouldRetry and wait errors', async () => {
+  const operationError = new Error('operation');
+  const predicateError = new Error('predicate');
+  await assert.rejects(retry(() => { throw operationError; }, {
+    attempts: 2,
+    shouldRetry: () => { throw predicateError; }
+  }), predicateError);
+
+  const waitError = new Error('wait');
+  await assert.rejects(retry(() => { throw operationError; }, {
+    attempts: 2,
+    wait: () => Promise.reject(waitError)
+  }), waitError);
+});
+
+test('fetchWithRetry retries the same URL and forwards options', async () => {
+  const urls = [];
+  let calls = 0;
+  const options = {attempts: 2};
+  const result = await fetchWithRetry(url => {
+    urls.push(url);
+    calls += 1;
+    if (calls === 1) throw new Error('retry');
+    return 'response';
+  }, 'local', options);
+  assert.equal(result, 'response');
+  assert.deepEqual(urls, ['local', 'local']);
+});
