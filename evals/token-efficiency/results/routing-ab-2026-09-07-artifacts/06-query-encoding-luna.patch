 'use strict';
 const test=require('node:test'),assert=require('node:assert/strict');
+const {queryPairs}=require('../src/query.js');
 const {buildSearch}=require('../src/search.js');
 test('basic',()=>assert.equal(buildSearch({q:'term'}),'?q=term'));
+test('queryPairs preserves scalar values and entry order',()=>{
+  assert.deepEqual(queryPairs({a:0,b:false,c:'',d:null,e:undefined}),[
+    ['a','0'],['b','false'],['c','']
+  ]);
+});
+test('queryPairs expands arrays without mutation',()=>{
+  const values=[0,null,'',false,undefined,2];
+  assert.deepEqual(queryPairs({x:values}),[['x','0'],['x',''],['x','false'],['x','2']]);
+  assert.deepEqual(values,[0,null,'',false,undefined,2]);
+});
+test('queryPairs ignores unsupported and nested values',()=>{
+  assert.deepEqual(queryPairs({object:{a:1},fn:()=>{},symbol:Symbol('x'),bigint:1n,nested:[[1]],nil:null}),[]);
+});
+test('buildSearch encodes query pairs and is empty without pairs',()=>{
+  assert.equal(buildSearch({q:'a b&c',tag:['x/y',''],zero:0}),'?q=a+b%26c&tag=x%2Fy&tag=&zero=0');
+  assert.equal(buildSearch({a:null,b:undefined,object:{}}),'');
+});
