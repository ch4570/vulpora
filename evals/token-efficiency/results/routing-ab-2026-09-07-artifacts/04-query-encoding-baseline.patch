diff --git a/src/query.js b/src/query.js
index ccd7d9e..46f67aa 100644
--- a/src/query.js
+++ b/src/query.js
@@ -1,3 +1,19 @@
 'use strict';
-function queryPairs(filters){return Object.entries(filters).filter(([,value])=>value).map(([key,value])=>[key,String(value)]);}
+function queryPairs(filters){
+  const pairs=[];
+
+  for(const [key,value] of Object.entries(filters)){
+    if(Array.isArray(value)){
+      for(const element of value){
+        if(typeof element==='string'||typeof element==='number'||typeof element==='boolean'){
+          pairs.push([key,String(element)]);
+        }
+      }
+    }else if(typeof value==='string'||typeof value==='number'||typeof value==='boolean'){
+      pairs.push([key,String(value)]);
+    }
+  }
+
+  return pairs;
+}
 module.exports={queryPairs};
diff --git a/src/search.js b/src/search.js
index 65f12d1..4edff30 100644
--- a/src/search.js
+++ b/src/search.js
@@ -1,3 +1,8 @@
 'use strict';
-function buildSearch(filters){return '?'+Object.entries(filters).map(([key,value])=>key+'='+value).join('&');}
+const {queryPairs}=require('./query.js');
+
+function buildSearch(filters){
+  const query=new URLSearchParams(queryPairs(filters)).toString();
+  return query?'?'+query:'';
+}
 module.exports={buildSearch};
diff --git a/test/search.test.js b/test/search.test.js
index ca55db6..18a804d 100644
--- a/test/search.test.js
+++ b/test/search.test.js
@@ -1,4 +1,35 @@
 'use strict';
 const test=require('node:test'),assert=require('node:assert/strict');
+const {queryPairs}=require('../src/query.js');
 const {buildSearch}=require('../src/search.js');
+
 test('basic',()=>assert.equal(buildSearch({q:'term'}),'?q=term'));
+
+test('queryPairs preserves entry and array order for scalar values',()=>{
+  const filters={text:'',page:0,exact:false,tags:['one',2,true,'']};
+  assert.deepEqual(queryPairs(filters),[
+    ['text',''],['page','0'],['exact','false'],
+    ['tags','one'],['tags','2'],['tags','true'],['tags','']
+  ]);
+});
+
+test('queryPairs omits unsupported values without mutating inputs',()=>{
+  const tags=['first',null,undefined,{nested:true},['nested'],false,3n,Symbol('tag')];
+  const filters={none:null,missing:undefined,object:{a:1},fn:()=>{},symbol:Symbol('x'),big:1n,tags};
+  const originalTags=[...tags];
+
+  assert.deepEqual(queryPairs(filters),[['tags','first'],['tags','false']]);
+  assert.deepEqual(tags,originalTags);
+  assert.equal(filters.tags,tags);
+});
+
+test('buildSearch serializes supported pairs with URLSearchParams',()=>{
+  assert.equal(
+    buildSearch({q:'a b&c',tag:['first',null,'two'],page:0,exact:false,empty:''}),
+    '?q=a+b%26c&tag=first&tag=two&page=0&exact=false&empty='
+  );
+});
+
+test('buildSearch returns an empty string when no supported pairs remain',()=>{
+  assert.equal(buildSearch({none:null,nested:[['value']],object:{value:true}}),'');
+});
