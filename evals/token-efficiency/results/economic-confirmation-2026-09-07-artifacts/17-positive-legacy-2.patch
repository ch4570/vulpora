 'use strict';
 function absolute(value){return value<0?-value:value;}
-module.exports={absolute};
+function isPositive(value){return typeof value==='number'&&Number.isFinite(value)&&value>0;}
+module.exports={absolute,isPositive};
diff --git a/test/numbers.test.js b/test/numbers.test.js
index a87097c..8367734 100644
--- a/test/numbers.test.js
+++ b/test/numbers.test.js
@@ -1,5 +1,15 @@
 'use strict';
 const test=require('node:test');
 const assert=require('node:assert/strict');
-const {absolute}=require('../src/numbers.js');
+const {absolute,isPositive}=require('../src/numbers.js');
 test('absolute',()=>assert.equal(absolute(-2),2));
+test('isPositive accepts finite numbers greater than zero',()=>{
+  assert.equal(isPositive(1),true);
+  assert.equal(isPositive(0.5),true);
+});
+test('isPositive rejects zero, negatives, NaN, and infinities',()=>{
+  for(const value of [0,-0,-1,-0.5,NaN,Infinity,-Infinity])assert.equal(isPositive(value),false);
+});
+test('isPositive rejects non-numbers',()=>{
+  for(const value of [undefined,null,true,false,'1',{},[],1n,Symbol('1'),new Number(1)])assert.equal(isPositive(value),false);
+});
