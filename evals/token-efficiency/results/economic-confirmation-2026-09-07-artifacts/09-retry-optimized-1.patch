diff --git a/src/retry.js b/src/retry.js
index 91d1837..1f48b13 100644
--- a/src/retry.js
+++ b/src/retry.js
@@ -1,3 +1,31 @@
 'use strict';
-async function retry(operation){return operation(1);}
+
+async function retry(operation, options = {}) {
+  const {
+    attempts = 3,
+    shouldRetry = () => true,
+    wait = async () => {},
+  } = options;
+
+  if (!Number.isFinite(attempts) || !Number.isInteger(attempts) || attempts <= 0) {
+    throw new RangeError('attempts must be a positive integer');
+  }
+
+  for (let attempt = 1; attempt <= attempts; attempt += 1) {
+    try {
+      return await operation(attempt);
+    } catch (error) {
+      if (attempt === attempts) {
+        throw error;
+      }
+
+      if (!await shouldRetry(error, attempt)) {
+        throw error;
+      }
+
+      await wait(attempt, error);
+    }
+  }
+}
+
 module.exports={retry};
diff --git a/test/retry.test.js b/test/retry.test.js
index fc01914..01aad71 100644
--- a/test/retry.test.js
+++ b/test/retry.test.js
@@ -2,6 +2,78 @@
 const test=require('node:test');
 const assert=require('node:assert/strict');
 const {retry}=require('../src/retry.js');
-const {fetchOnce}=require('../src/client.js');
+const {fetchOnce,fetchWithRetry}=require('../src/client.js');
 test('immediate success',async()=>assert.equal(await retry(()=>7),7));
 test('fetchOnce',async()=>assert.equal(await fetchOnce(x=>x,'local'), 'local'));
+
+test('retries failures and returns the first successful value',async()=>{
+  const attempts=[];
+  const result=await retry(attempt=>{
+    attempts.push(attempt);
+    if(attempt<3) throw new Error('temporary');
+    return {attempt};
+  });
+  assert.deepEqual(attempts,[1,2,3]);
+  assert.deepEqual(result,{attempt:3});
+});
+
+test('validates attempts before running the operation',async()=>{
+  for(const attempts of [0,-1,1.5,NaN,Infinity,'3']){
+    let called=false;
+    await assert.rejects(retry(()=>{called=true;}, {attempts}),RangeError);
+    assert.equal(called,false);
+  }
+});
+
+test('stops when retry is declined and preserves the error',async()=>{
+  const error=new Error('stop');
+  let waits=0;
+  await assert.rejects(
+    retry(()=>{throw error;},{shouldRetry:(received,attempt)=>{
+      assert.strictEqual(received,error);
+      assert.equal(attempt,1);
+      return false;
+    },wait:()=>{waits+=1;}}),
+    received=>received===error,
+  );
+  assert.equal(waits,0);
+});
+
+test('does not call hooks after the final failed attempt',async()=>{
+  const error=new Error('final');
+  let predicates=0;
+  let waits=0;
+  await assert.rejects(
+    retry(()=>Promise.reject(error),{attempts:1,shouldRetry:()=>{predicates+=1;},wait:()=>{waits+=1;}}),
+    received=>received===error,
+  );
+  assert.equal(predicates,0);
+  assert.equal(waits,0);
+});
+
+test('wait receives the failed attempt and errors from hooks stop retries',async()=>{
+  const original=new Error('original');
+  const predicateError=new Error('predicate');
+  await assert.rejects(retry(()=>{throw original;},{shouldRetry:()=>{throw predicateError;}}),received=>received===predicateError);
+
+  const waitError=new Error('wait');
+  await assert.rejects(
+    retry(()=>{throw original;},{wait:async(attempt,error)=>{
+      assert.equal(attempt,1);
+      assert.strictEqual(error,original);
+      throw waitError;
+    }}),
+    received=>received===waitError,
+  );
+});
+
+test('fetchWithRetry retries fetcher calls and forwards options',async()=>{
+  let calls=0;
+  const value=await fetchWithRetry(url=>{
+    calls+=1;
+    if(calls===1) throw new Error('retry');
+    return url;
+  },'local',{attempts:2});
+  assert.equal(value,'local');
+  assert.equal(calls,2);
+});
