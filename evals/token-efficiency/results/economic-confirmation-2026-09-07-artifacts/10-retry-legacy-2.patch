diff --git a/src/retry.js b/src/retry.js
index 91d1837..e15494e 100644
--- a/src/retry.js
+++ b/src/retry.js
@@ -1,3 +1,25 @@
 'use strict';
-async function retry(operation){return operation(1);}
+
+async function retry(operation, options = {}) {
+  const {
+    attempts = 3,
+    shouldRetry = () => true,
+    wait = async () => {},
+  } = options;
+
+  if (!Number.isFinite(attempts) || !Number.isInteger(attempts) || attempts <= 0) {
+    throw new RangeError('attempts must be a positive integer');
+  }
+
+  for (let attempt = 1; attempt <= attempts; attempt += 1) {
+    try {
+      return await operation(attempt);
+    } catch (error) {
+      if (attempt === attempts) throw error;
+      if (!await shouldRetry(error, attempt)) throw error;
+      await wait(attempt, error);
+    }
+  }
+}
+
 module.exports={retry};
diff --git a/test/retry.test.js b/test/retry.test.js
index fc01914..98e0831 100644
--- a/test/retry.test.js
+++ b/test/retry.test.js
@@ -2,6 +2,111 @@
 const test=require('node:test');
 const assert=require('node:assert/strict');
 const {retry}=require('../src/retry.js');
-const {fetchOnce}=require('../src/client.js');
+const {fetchOnce,fetchWithRetry}=require('../src/client.js');
 test('immediate success',async()=>assert.equal(await retry(()=>7),7));
 test('fetchOnce',async()=>assert.equal(await fetchOnce(x=>x,'local'), 'local'));
+
+test('retries failures with one-based attempt numbers and waits between calls', async () => {
+  const attempts=[];
+  const waits=[];
+  const failure=new Error('temporary');
+  const result=await retry(attempt => {
+    attempts.push(attempt);
+    if (attempt < 3) throw failure;
+    return {attempt};
+  }, {wait: async (attempt, error) => waits.push([attempt, error])});
+
+  assert.deepEqual(attempts, [1, 2, 3]);
+  assert.deepEqual(waits, [[1, failure], [2, failure]]);
+  assert.deepEqual(result, {attempt: 3});
+});
+
+test('uses three total calls by default', async () => {
+  let calls=0;
+  const failure=new Error('failed');
+  await assert.rejects(retry(() => {
+    calls += 1;
+    throw failure;
+  }), error => error === failure);
+  assert.equal(calls, 3);
+});
+
+test('validates attempts before calling the operation', async () => {
+  for (const attempts of ['3', 1.5, 0, -1, Infinity, NaN]) {
+    let calls=0;
+    await assert.rejects(retry(() => { calls += 1; }, {attempts}), RangeError);
+    assert.equal(calls, 0);
+  }
+});
+
+test('does not invoke retry hooks after the final failure', async () => {
+  const failure=new Error('final');
+  let predicateCalls=0;
+  let waitCalls=0;
+  await assert.rejects(retry(() => { throw failure; }, {
+    attempts: 1,
+    shouldRetry: () => { predicateCalls += 1; return true; },
+    wait: () => { waitCalls += 1; },
+  }), error => error === failure);
+  assert.equal(predicateCalls, 0);
+  assert.equal(waitCalls, 0);
+});
+
+test('stops and preserves the original error when shouldRetry returns false', async () => {
+  const failure=new Error('stop');
+  let calls=0;
+  let waits=0;
+  await assert.rejects(retry(() => {
+    calls += 1;
+    throw failure;
+  }, {shouldRetry: (error, attempt) => {
+    assert.equal(error, failure);
+    assert.equal(attempt, 1);
+    return false;
+  }, wait: () => { waits += 1; }}), error => error === failure);
+  assert.equal(calls, 1);
+  assert.equal(waits, 0);
+});
+
+test('propagates errors from shouldRetry and wait without another operation call', async () => {
+  const failure=new Error('operation');
+  const predicateFailure=new Error('predicate');
+  let calls=0;
+  await assert.rejects(retry(() => {
+    calls += 1;
+    throw failure;
+  }, {shouldRetry: () => { throw predicateFailure; }}), error => error === predicateFailure);
+  assert.equal(calls, 1);
+
+  const waitFailure=new Error('wait');
+  calls=0;
+  await assert.rejects(retry(async () => {
+    calls += 1;
+    throw failure;
+  }, {wait: async () => { throw waitFailure; }}), error => error === waitFailure);
+  assert.equal(calls, 1);
+});
+
+test('supports asynchronous rejections', async () => {
+  const failure=new Error('retry me');
+  let calls=0;
+  assert.equal(await retry(async attempt => {
+    calls += 1;
+    if (attempt === 1) return Promise.reject(failure);
+    return 'done';
+  }), 'done');
+  assert.equal(calls, 2);
+});
+
+test('fetchWithRetry retries fetcher(url) and forwards retry options', async () => {
+  const urls=[];
+  let calls=0;
+  const value=await fetchWithRetry(url => {
+    urls.push(url);
+    calls += 1;
+    if (calls === 1) throw new Error('temporary');
+    return 'response';
+  }, 'local', {attempts: 2});
+  assert.equal(value, 'response');
+  assert.deepEqual(urls, ['local', 'local']);
+});
