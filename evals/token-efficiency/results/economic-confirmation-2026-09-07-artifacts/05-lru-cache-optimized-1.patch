+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const {LRUCache} = require('../src/lru.js');
+
+test('stores a value', () => {
+  const cache = new LRUCache(2);
+  cache.set('a', 1);
+  assert.equal(cache.get('a'), 1);
+});
+
+test('rejects non-positive, fractional, and non-number capacities', () => {
+  for (const capacity of [0, -1, 1.5, NaN, Infinity, '1', null, undefined]) {
+    assert.throws(() => new LRUCache(capacity), RangeError);
+  }
+});
+
+test('stores falsy values and undefined as members', () => {
+  const cache = new LRUCache(5);
+  for (const [key, value] of [['false', false], ['zero', 0], ['empty', ''], ['null', null], ['undefined', undefined]]) {
+    assert.strictEqual(cache.set(key, value), cache);
+    assert.equal(cache.has(key), true);
+    assert.strictEqual(cache.get(key), value);
+  }
+  assert.equal(cache.size, 5);
+});
+
+test('refreshes recency on get and evicts the least-recently-used key', () => {
+  const cache = new LRUCache(2);
+  cache.set('a', 1).set('b', 2);
+  assert.equal(cache.get('a'), 1);
+  cache.set('c', 3);
+
+  assert.equal(cache.has('a'), true);
+  assert.equal(cache.has('b'), false);
+  assert.equal(cache.get('c'), 3);
+});
+
+test('refreshes recency on updates without evicting another entry', () => {
+  const cache = new LRUCache(2);
+  cache.set('a', 1).set('b', 2).set('a', 3);
+
+  assert.equal(cache.size, 2);
+  assert.equal(cache.get('a'), 3);
+  assert.equal(cache.has('b'), true);
+  cache.set('c', 4);
+  assert.equal(cache.has('a'), true);
+  assert.equal(cache.has('b'), false);
+});
+
+test('has, size, and misses do not refresh recency', () => {
+  const cache = new LRUCache(2);
+  cache.set('a', 1).set('b', 2);
+  assert.equal(cache.has('a'), true);
+  assert.equal(cache.size, 2);
+  assert.equal(cache.get('missing'), undefined);
+  cache.set('c', 3);
+
+  assert.equal(cache.has('a'), false);
+  assert.equal(cache.has('b'), true);
+});
+
+test('uses Map key identity', () => {
+  const cache = new LRUCache(2);
+  const first = {};
+  const second = {};
+  cache.set(first, 'first').set(second, 'second');
+
+  assert.equal(cache.get(first), 'first');
+  assert.equal(cache.has({}), false);
+});
