+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { LRUCache } = require('../src/lru.js');
+
+test('rejects capacities that are not positive integers', () => {
+  for (const capacity of [0, -1, 1.5, NaN, Infinity, '2', null, undefined]) {
+    assert.throws(() => new LRUCache(capacity), RangeError);
+  }
+});
+
+test('stores every JavaScript value and returns itself from set', () => {
+  const cache = new LRUCache(5);
+  const entries = [['false', false], ['zero', 0], ['empty', ''], ['null', null], ['undefined', undefined]];
+
+  for (const [key, value] of entries) assert.equal(cache.set(key, value), cache);
+  for (const [key, value] of entries) assert.strictEqual(cache.get(key), value);
+  assert.equal(cache.size, entries.length);
+  assert.equal(cache.has('undefined'), true);
+});
+
+test('get and set refresh recency while has and size do not', () => {
+  const cache = new LRUCache(2);
+  cache.set('a', 1).set('b', 2);
+  assert.equal(cache.get('a'), 1);
+  cache.set('c', 3);
+  assert.equal(cache.has('a'), true);
+  assert.equal(cache.has('b'), false);
+
+  cache.has('a');
+  void cache.size;
+  cache.set('d', 4);
+  assert.equal(cache.has('a'), false);
+  assert.equal(cache.has('c'), true);
+  assert.equal(cache.has('d'), true);
+});
+
+test('updates an existing key without eviction and treats object keys by identity', () => {
+  const cache = new LRUCache(2);
+  const first = {};
+  const second = {};
+  const equivalentButDistinct = {};
+
+  cache.set(first, 'first').set(second, 'second');
+  cache.set(first, 'updated');
+  cache.set('third', 3);
+  assert.equal(cache.size, 2);
+  assert.equal(cache.get(first), 'updated');
+  assert.equal(cache.has(second), false);
+  assert.equal(cache.get(equivalentButDistinct), undefined);
+  assert.equal(cache.has(first), true);
+});
