+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { retry } = require('../src/retry.js');
+const { fetchOnce, fetchWithRetry } = require('../src/client.js');
+
+test('returns the first successful value and passes one-based attempt numbers', async () => {
+  const attempts = [];
+  const value = await retry((attempt) => {
+    attempts.push(attempt);
+    if (attempt < 3) throw new Error('try again');
+    return { value: 'success' };
+  });
+
+  assert.deepEqual(value, { value: 'success' });
+  assert.deepEqual(attempts, [1, 2, 3]);
+});
+
+test('uses three total calls by default and invokes wait between failures', async () => {
+  const calls = [];
+  const waits = [];
+  const failure = new Error('failed');
+
+  await assert.rejects(
+    retry(() => {
+      calls.push('call');
+      throw failure;
+    }, { wait: async (attempt, error) => waits.push([attempt, error]) }),
+    (error) => error === failure,
+  );
+
+  assert.equal(calls.length, 3);
+  assert.deepEqual(waits, [[1, failure], [2, failure]]);
+});
+
+test('validates attempts before calling the operation', async () => {
+  for (const attempts of [0, -1, 1.5, Infinity, NaN, '3']) {
+    let called = false;
+    await assert.rejects(
+      retry(() => {
+        called = true;
+      }, { attempts }),
+      RangeError,
+    );
+    assert.equal(called, false);
+  }
+});
+
+test('does not consult retry hooks on the final failure', async () => {
+  const failure = new Error('final');
+  let predicateCalls = 0;
+  let waitCalls = 0;
+
+  await assert.rejects(
+    retry(() => { throw failure; }, {
+      attempts: 1,
+      shouldRetry: () => { predicateCalls += 1; return true; },
+      wait: () => { waitCalls += 1; },
+    }),
+    (error) => error === failure,
+  );
+
+  assert.equal(predicateCalls, 0);
+  assert.equal(waitCalls, 0);
+});
+
+test('stops when shouldRetry declines and propagates hook errors', async () => {
+  const failure = new Error('operation');
+  let calls = 0;
+  await assert.rejects(
+    retry(() => { calls += 1; throw failure; }, { shouldRetry: () => false }),
+    (error) => error === failure,
+  );
+  assert.equal(calls, 1);
+
+  const predicateFailure = new Error('predicate');
+  await assert.rejects(
+    retry(() => { throw failure; }, { shouldRetry: () => { throw predicateFailure; } }),
+    (error) => error === predicateFailure,
+  );
+
+  const waitFailure = new Error('wait');
+  await assert.rejects(
+    retry(() => { throw failure; }, { wait: () => Promise.reject(waitFailure) }),
+    (error) => error === waitFailure,
+  );
+});
+
+test('handles async rejections and forwards fetchWithRetry options', async () => {
+  let calls = 0;
+  assert.equal(await retry(async (attempt) => {
+    calls += 1;
+    if (attempt === 1) return Promise.reject(new Error('temporary'));
+    return 'recovered';
+  }), 'recovered');
+  assert.equal(calls, 2);
+
+  const urls = [];
+  assert.equal(await fetchWithRetry((url) => {
+    urls.push(url);
+    if (urls.length === 1) throw new Error('temporary');
+    return 'response';
+  }, 'local', { attempts: 2 }), 'response');
+  assert.deepEqual(urls, ['local', 'local']);
+});
+
+test('fetchOnce', async () => assert.equal(await fetchOnce((x) => x, 'local'), 'local'));
